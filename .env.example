# CDF cluster hostname prefix, for example westeurope-1 or api.
# The client calls https://<CDF_CLUSTER>.cognitedata.com
CDF_CLUSTER=

# CDF project name
CDF_PROJECT=

# Entra ID app registration used to sign in to CDF
CLIENT_ID=
TENANT_ID=

# interactive (browser login, default) or client_credentials (headless)
AUTH_FLOW=interactive

# Required only when AUTH_FLOW=client_credentials
# CLIENT_SECRET=
