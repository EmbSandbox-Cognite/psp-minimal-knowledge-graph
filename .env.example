# Copy this file to .env and fill in your CDF project values.
# .env is gitignored. Do not commit secrets.

CDF_PROJECT=
CDF_CLUSTER=

# Client credentials. Leave blank if you sign in another way.
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_TENANT_ID=
IDP_TOKEN_URL=

# Optional pre-issued token.
# CDF_TOKEN=
