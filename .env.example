# CDF cluster hostname prefix, for example westeurope-1 or api.
# The client calls https://<CDF_CLUSTER>.cognitedata.com
CDF_CLUSTER=

# CDF project name
CDF_PROJECT=

# Entra ID app registration used to sign in to CDF
IDP_CLIENT_ID=
IDP_TENANT_ID=

# client_credentials (default) or interactive (browser login)
LOGIN_FLOW=client_credentials

# Required when LOGIN_FLOW=client_credentials
IDP_CLIENT_SECRET=
